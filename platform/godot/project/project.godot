config_version=5

[application]
config/name="RoadWars Reconstruction"
run/main_scene="res://bootstrap.tscn"

[display]
window/size/viewport_width=960
window/size/viewport_height=540

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="vulkan"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.065, 1)
